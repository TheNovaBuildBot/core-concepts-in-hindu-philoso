<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.name }} | {{ site.name }}</title>
  <meta name="description" content="{{ description or site.specialty }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  
  <!-- Open Graph (og:image omitted until an image is uploaded to /assets/og-image.jpg) -->
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.specialty }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">

  <!-- Twitter Card (text-only summary until og-image exists) -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title or site.name }}">
  <meta name="twitter:description" content="{{ description or site.specialty }}">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
  
  <!-- Structured Data (Schema.org) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "{{ site.name }}",
    "description": "{{ site.specialty }}",
    "url": "{{ site.url }}",
    "email": "{{ site.email }}",
    "telephone": "{{ site.phone }}",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "{{ site.city }}",
      "addressCountry": "IN"
    }
  }
  </script>
  
  <style>
    /* CSS Custom Properties */
    :root {
      --primary-color: #1a2a4a;
      --secondary-color: #d4af37;
      --accent-color: #f5f0e8;
      --text-color: #1a1a1a;
      --text-light: #666666;
      --border-color: #e0d5c7;
      --shadow: 0 10px 40px rgba(26, 42, 74, 0.1);
      --shadow-hover: 0 20px 60px rgba(26, 42, 74, 0.15);
      --spacing-base: 8px;
      --spacing-section: 80px;
    }

    /* Typography */
    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.6;
      color: var(--text-color);
      background-color: #fafbf9;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.015em;
      margin: 0;
    }

    h1 {
      font-size: 40px;
    }

    h2 {
      font-size: 24px;
      margin-bottom: calc(var(--spacing-base) * 6);
    }

    h3 {
      font-size: 20px;
      margin-bottom: calc(var(--spacing-base) * 4);
    }

    p {
      margin: 0 0 calc(var(--spacing-base) * 2) 0;
    }

    a {
      color: var(--secondary-color);
      text-decoration: none;
      transition: color 0.35s ease;
    }

    a:hover {
      color: var(--primary-color);
    }

    /* Layout */
    section {
      padding: var(--spacing-section) calc(var(--spacing-base) * 4);
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 calc(var(--spacing-base) * 4);
    }

    .section-header {
      text-align: center;
      margin-bottom: calc(var(--spacing-base) * 10);
      max-width: 680px;
      margin-left: auto;
      margin-right: auto;
    }

    .eyebrow {
      font-size: 12px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--secondary-color);
      margin-bottom: calc(var(--spacing-base) * 2);
      display: block;
    }

    .lead {
      font-size: 18px;
      color: var(--text-light);
      margin-top: calc(var(--spacing-base) * 3);
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: calc(var(--spacing-base) * 2);
      padding: 16px calc(var(--spacing-base) * 4);
      border-radius: 999px;
      font-weight: 600;
      font-size: 16px;
      cursor: pointer;
      transition: all 0.35s ease;
      text-decoration: none;
      border: 2px solid transparent;
    }

    .btn-primary {
      background-color: var(--secondary-color);
      color: var(--primary-color);
    }

    .btn-primary:hover {
      background-color: #e0a030;
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    .btn-ghost {
      border: 2px solid var(--secondary-color);
      color: var(--secondary-color);
      background-color: transparent;
    }

    .btn-ghost:hover {
      background-color: rgba(212, 175, 55, 0.1);
      transform: translateY(-2px);
    }

    .btn-arrow {
      transition: transform 0.35s ease;
    }

    .btn:hover .btn-arrow {
      transform: translateX(3px);
    }

    /* Navigation */
    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background-color: transparent;
      transition: all 0.35s ease;
      border-bottom: 1px solid transparent;
    }

    header.scrolled {
      background-color: rgba(250, 251, 249, 0.95);
      backdrop-filter: blur(10px);
      border-bottom-color: var(--border-color);
      box-shadow: 0 2px 10px rgba(26, 42, 74, 0.05);
    }

    nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: calc(var(--spacing-base) * 3) calc(var(--spacing-base) * 4);
      max-width: 1200px;
      margin: 0 auto;
    }

    .logo {
      font-size: 18px;
      font-weight: 600;
      color: var(--primary-color);
      letter-spacing: -0.01em;
    }

    .nav-links {
      display: flex;
      gap: calc(var(--spacing-base) * 6);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-links a {
      color: var(--text-color);
      font-weight: 500;
      font-size: 14px;
      position: relative;
      padding-bottom: 4px;
      display: inline-block;
    }

    .nav-links a::after {
      content: '';
      position: absolute;
      bottom: 0;
      right: 0;
      width: 100%;
      height: 2px;
      background-color: var(--secondary-color);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.35s ease;
    }

    .nav-links a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .hamburger {
      display: none;
      flex-direction: column;
      gap: 6px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
    }

    .hamburger span {
      width: 24px;
      height: 2px;
      background-color: var(--primary-color);
      transition: all 0.35s ease;
    }

    .hamburger.active span:nth-child(1) {
      transform: rotate(45deg) translate(10px, 10px);
    }

    .hamburger.active span:nth-child(2) {
      opacity: 0;
    }

    .hamburger.active span:nth-child(3) {
      transform: rotate(-45deg) translate(7px, -7px);
    }

    /* Hero CTA row (shared) */
    .hero-ctas {
      display: flex;
      gap: calc(var(--spacing-base) * 3);
      flex-wrap: wrap;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Sections */
    .section-alt {
      background-color: #f0ebe2;
    }

    .section-alt-2 {
      background-color: #fafbf9;
    }

    /* Cards */
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: calc(var(--spacing-base) * 6);
      margin-top: calc(var(--spacing-base) * 8);
    }

    .card {
      background-color: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(26, 42, 74, 0.08);
      transition: all 0.35s ease;
      display: flex;
      flex-direction: column;
    }

    .card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
    }

    .card-body {
      padding: calc(var(--spacing-base) * 5);
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .card h3 {
      margin-bottom: calc(var(--spacing-base) * 2);
    }

    .card p {
      color: var(--text-light);
      margin-bottom: calc(var(--spacing-base) * 4);
      flex: 1;
    }

    .card-link {
      color: var(--secondary-color);
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: gap 0.35s ease;
    }

    .card-link:hover {
      gap: 10px;
    }

    /* About Section text */
    .about-text p {
      color: var(--text-light);
      margin-bottom: calc(var(--spacing-base) * 3);
    }

    /* Contact Section */
    .contact-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: calc(var(--spacing-base) * 8);
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing-base) * 4);
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing-base) * 1);
    }

    .form-group label {
      font-weight: 500;
      font-size: 14px;
      color: var(--text-color);
    }

    .form-group input,
    .form-group textarea {
      padding: 12px calc(var(--spacing-base) * 3);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      font-family: inherit;
      font-size: 16px;
      transition: border-color 0.35s ease;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--secondary-color);
    }

    .form-group textarea {
      resize: vertical;
      min-height: 140px;
    }

    .form-message {
      padding: calc(var(--spacing-base) * 3);
      border-radius: 6px;
      text-align: center;
      margin-top: calc(var(--spacing-base) * 2);
      display: none;
      font-size: 14px;
    }

    .form-message.success {
      background-color: #e8f5e9;
      color: #2e7d32;
      display: block;
    }

    .form-message.error {
      background-color: #ffebee;
      color: #c62828;
      display: block;
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: calc(var(--spacing-base) * 5);
    }

    .contact-info-block h3 {
      margin-bottom: calc(var(--spacing-base) * 2);
    }

    .contact-info-block p {
      color: var(--text-light);
      margin: 0;
    }

    .contact-info-block a {
      display: block;
      margin-top: calc(var(--spacing-base) * 1);
    }

    /* Footer */
    footer {
      background-color: var(--primary-color);
      color: #ffffff;
      padding: calc(var(--spacing-base) * 8) calc(var(--spacing-base) * 4);
    }

    footer .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 calc(var(--spacing-base) * 4);
    }

    .footer-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: calc(var(--spacing-base) * 6);
      margin-bottom: calc(var(--spacing-base) * 6);
    }

    .footer-section h3 {
      color: var(--secondary-color);
      margin-bottom: calc(var(--spacing-base) * 3);
      font-size: 16px;
    }

    .footer-section ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-section li {
      margin-bottom: calc(var(--spacing-base) * 2);
    }

    .footer-section a {
      color: rgba(255, 255, 255, 0.8);
      font-size: 14px;
      transition: color 0.35s ease;
    }

    .footer-section a:hover {
      color: var(--secondary-color);
    }

    .footer-copyright {
      padding-top: calc(var(--spacing-base) * 6);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      text-align: center;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.6);
    }

    .footer-credit {
      margin-top: calc(var(--spacing-base) * 2);
    }

    /* =============================================
       HERO — SPLIT LAYOUT (Book Cover + Text)
       ============================================= */
    .hero-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }

    /* Left panel — warm cream background */
    .hero-split-visual {
      background: linear-gradient(145deg, #f5f0e8 0%, #ede5d4 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 80px 60px;
      position: relative;
      overflow: hidden;
    }

    /* Subtle mandala-like pattern in background */
    .hero-split-visual::before {
      content: '';
      position: absolute;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      border: 60px solid rgba(212, 175, 55, 0.08);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .hero-split-visual::after {
      content: '';
      position: absolute;
      width: 360px;
      height: 360px;
      border-radius: 50%;
      border: 30px solid rgba(212, 175, 55, 0.06);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
    }

    .book-cover-wrap {
      position: relative;
      z-index: 1;
      animation: bookReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
    }

    @keyframes bookReveal {
      from {
        opacity: 0;
        transform: translateY(40px) rotate(-3deg);
      }
      to {
        opacity: 1;
        transform: translateY(0) rotate(-2deg);
      }
    }

    .book-cover-img {
      width: 320px;
      max-width: 100%;
      border-radius: 4px;
      box-shadow:
        0 4px 12px rgba(26, 42, 74, 0.15),
        0 20px 60px rgba(26, 42, 74, 0.25),
        0 40px 80px rgba(26, 42, 74, 0.12);
      display: block;
      transform: rotate(-2deg);
      transition: transform 0.6s ease, box-shadow 0.6s ease;
    }

    .book-cover-img:hover {
      transform: rotate(0deg) scale(1.02);
      box-shadow:
        0 8px 20px rgba(26, 42, 74, 0.2),
        0 30px 80px rgba(26, 42, 74, 0.3),
        0 60px 100px rgba(26, 42, 74, 0.15);
    }

    .book-cover-glow {
      position: absolute;
      bottom: -30px;
      left: 50%;
      transform: translateX(-50%) rotate(-2deg);
      width: 80%;
      height: 40px;
      background: radial-gradient(ellipse, rgba(26, 42, 74, 0.22) 0%, transparent 70%);
      filter: blur(10px);
      border-radius: 50%;
      pointer-events: none;
    }

    /* Right panel — deep navy */
    .hero-split-text {
      background: var(--primary-color);
      display: flex;
      align-items: center;
      padding: 80px 64px;
      position: relative;
      overflow: hidden;
    }

    /* Decorative corner accent */
    .hero-split-text::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle at top right, rgba(212, 175, 55, 0.12) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-split-text::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 160px;
      height: 160px;
      background: radial-gradient(circle at bottom left, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-inner {
      position: relative;
      z-index: 1;
      animation: fadeInUp 1.2s ease-out 0.5s both;
    }

    /* Ornament */
    .hero-ornament {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
    }

    .ornament-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--secondary-color), transparent);
      max-width: 60px;
    }

    .ornament-symbol {
      color: var(--secondary-color);
      font-size: 14px;
      line-height: 1;
    }

    /* Eyebrow on dark bg */
    .hero-split-text .hero-eyebrow {
      display: block;
      font-size: 12px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--secondary-color);
      margin-bottom: 20px;
    }

    /* Hero title */
    .hero-title {
      color: #ffffff;
      font-size: 42px;
      line-height: 1.15;
      margin-bottom: 28px;
      letter-spacing: -0.02em;
    }

    /* Decorative rule under title */
    .hero-title::after {
      content: '';
      display: block;
      width: 60px;
      height: 3px;
      background: var(--secondary-color);
      margin-top: 20px;
      border-radius: 2px;
    }

    /* Bio text */
    .hero-bio {
      color: rgba(255, 255, 255, 0.82);
      font-size: 16px;
      line-height: 1.75;
      margin-bottom: 40px;
    }

    .hero-bio em {
      color: var(--secondary-color);
      font-style: italic;
    }

    /* =============================================
       ABOUT SECTION — updated layout
       ============================================= */
    .about-content {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 64px;
      align-items: center;
    }

    .about-text .eyebrow {
      margin-bottom: 16px;
    }

    .about-text h2 {
      color: var(--primary-color);
      margin-bottom: 24px;
    }

    .about-visual {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 32px;
    }

    .about-book-img {
      width: 220px;
      border-radius: 4px;
      box-shadow:
        0 8px 24px rgba(26, 42, 74, 0.18),
        0 20px 40px rgba(26, 42, 74, 0.12);
      display: block;
      transition: transform 0.5s ease;
    }

    .about-book-img:hover {
      transform: translateY(-6px);
    }

    .about-author-card {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 20px 24px;
      box-shadow: 0 4px 16px rgba(26, 42, 74, 0.07);
      width: 100%;
      max-width: 280px;
    }

    .author-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--primary-color);
      color: var(--secondary-color);
      font-weight: 700;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      letter-spacing: 0.05em;
    }

    .author-name {
      display: block;
      font-weight: 600;
      font-size: 14px;
      color: var(--primary-color);
      margin-bottom: 4px;
    }

    .author-label {
      font-size: 12px;
      color: var(--secondary-color);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    /* =============================================
       CARDS — icon-based (no images)
       ============================================= */
    .card {
      background-color: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(26, 42, 74, 0.08);
      transition: all 0.35s ease;
      display: flex;
      flex-direction: column;
      border: 1px solid var(--border-color);
    }

    .card-icon {
      background: linear-gradient(135deg, var(--primary-color), #2a3f6f);
      color: var(--secondary-color);
      font-weight: 700;
      font-size: 20px;
      font-family: Georgia, serif;
      padding: 28px 32px;
      letter-spacing: 0.02em;
      border-bottom: 3px solid var(--secondary-color);
    }

    /* =============================================
       QUOTE / CTA BAND
       ============================================= */
    .section-quote {
      background: linear-gradient(135deg, var(--primary-color) 0%, #243558 100%);
      padding: var(--spacing-section) calc(var(--spacing-base) * 4);
      position: relative;
      overflow: hidden;
    }

    .section-quote::before {
      content: '';
      position: absolute;
      top: -80px;
      right: -80px;
      width: 320px;
      height: 320px;
      border-radius: 50%;
      border: 60px solid rgba(212, 175, 55, 0.07);
      pointer-events: none;
    }

    .quote-inner {
      text-align: center;
      max-width: 720px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .quote-mark {
      font-size: 72px;
      color: var(--secondary-color);
      opacity: 0.5;
      line-height: 1;
      margin-bottom: -16px;
      font-family: Georgia, serif;
    }

    .quote-text {
      font-size: 22px;
      line-height: 1.65;
      color: rgba(255, 255, 255, 0.9);
      font-style: italic;
      font-family: Georgia, 'Times New Roman', serif;
      margin: 0 0 20px;
      quotes: none;
    }

    .quote-cite {
      font-size: 13px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--secondary-color);
      font-style: normal;
    }

    /* =============================================
       RESPONSIVE — Hero split collapses to stack
       ============================================= */
    @media (max-width: 900px) {
      .hero-split {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .hero-split-visual {
        padding: 60px 40px 50px;
        min-height: 420px;
      }

      .book-cover-img {
        width: 240px;
        transform: rotate(-1deg);
      }

      .hero-split-text {
        padding: 60px 40px;
      }

      .hero-title {
        font-size: 32px;
      }

      .about-content {
        grid-template-columns: 1fr;
      }

      .about-visual {
        flex-direction: row;
        justify-content: center;
        flex-wrap: wrap;
      }
    }

    @media (max-width: 600px) {
      .hero-split-visual {
        padding: 48px 24px 40px;
        min-height: 340px;
      }

      .book-cover-img {
        width: 190px;
      }

      .hero-split-text {
        padding: 48px 24px;
      }

      .hero-title {
        font-size: 28px;
      }

      .hero-bio {
        font-size: 15px;
      }

      .quote-text {
        font-size: 18px;
      }

      .quote-mark {
        font-size: 52px;
      }
    }

    /* =============================================
       PURCHASE / BUY SECTION
       ============================================= */
    .section-buy {
      background: linear-gradient(160deg, #f5f0e8 0%, #ede5d4 100%);
    }

    .buy-channels {
      display: flex;
      align-items: flex-start;
      gap: 40px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 48px;
    }

    .buy-group {
      flex: 1;
      min-width: 240px;
      max-width: 340px;
      background: #ffffff;
      border-radius: 16px;
      padding: 36px 32px;
      box-shadow: 0 4px 24px rgba(26, 42, 74, 0.08);
      border: 1px solid var(--border-color);
    }

    .buy-group-label {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--primary-color);
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 2px solid var(--secondary-color);
    }

    .buy-group-icon {
      font-size: 20px;
      line-height: 1;
    }

    .buy-links {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .buy-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      border-radius: 10px;
      border: 1.5px solid var(--border-color);
      background: #fafbf9;
      color: var(--text-color);
      font-weight: 600;
      font-size: 15px;
      text-decoration: none;
      transition: all 0.28s ease;
    }

    .buy-link:hover {
      background: var(--primary-color);
      border-color: var(--primary-color);
      color: #ffffff;
      transform: translateX(4px);
      box-shadow: 0 6px 20px rgba(26, 42, 74, 0.18);
    }

    .buy-link-retailer {
      color: inherit;
    }

    .buy-link-arrow {
      color: var(--secondary-color);
      font-size: 16px;
      transition: transform 0.28s ease, color 0.28s ease;
    }

    .buy-link:hover .buy-link-arrow {
      transform: translateX(4px);
      color: var(--secondary-color);
    }

    .buy-divider {
      display: none;
    }

    @media (max-width: 768px) {
      .buy-channels {
        flex-direction: column;
        align-items: center;
        gap: 24px;
      }

      .buy-group {
        max-width: 100%;
        width: 100%;
      }
    }

    /* Scroll Reveal */
    [data-scroll-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    [data-scroll-reveal].revealed {
      opacity: 1;
      transform: translateY(0);
    }

    /* Responsive */
    @media (max-width: 768px) {
      h1 {
        font-size: 32px;
      }

      h2 {
        font-size: 20px;
      }

      section {
        padding: 60px calc(var(--spacing-base) * 3);
      }

      .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        flex-direction: column;
        gap: 0;
        background-color: #fafbf9;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s ease;
        box-shadow: 0 10px 30px rgba(26, 42, 74, 0.1);
      }

      .nav-links.active {
        max-height: 300px;
      }

      .nav-links li {
        border-bottom: 1px solid var(--border-color);
      }

      .nav-links a {
        display: block;
        padding: calc(var(--spacing-base) * 3) calc(var(--spacing-base) * 4);
      }

      .hamburger {
        display: flex;
      }

      .hero h1 {
        font-size: 36px;
      }

      .hero-content {
        max-width: 100%;
      }

      .hero-ctas {
        flex-direction: column;
        gap: calc(var(--spacing-base) * 2);
      }

      .btn {
        justify-content: center;
      }

      .about-content,
      .contact-content {
        grid-template-columns: 1fr;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      .lead {
        font-size: 16px;
      }
    }

    @media (max-width: 480px) {
      section {
        padding: 40px calc(var(--spacing-base) * 2);
      }

      h1 {
        font-size: 24px;
      }

      h2 {
        font-size: 18px;
      }

      .container {
        padding: 0 calc(var(--spacing-base) * 2);
      }

      nav {
        padding: calc(var(--spacing-base) * 2) calc(var(--spacing-base) * 2);
      }

      .logo {
        font-size: 16px;
      }

      .hero h1 {
        font-size: 28px;
      }

      .hero-content {
        padding: calc(var(--spacing-base) * 4) calc(var(--spacing-base) * 2);
      }

      .section-header {
        margin-bottom: calc(var(--spacing-base) * 6);
      }
    }
  </style>
</head>
<body>
  {% include "header.njk" %}
  
  <main>
    {{ content | safe }}
  </main>
  
  {% include "footer.njk" %}
  
  {% if site.ga_id %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.ga_id }}');
  </script>
  {% endif %}

  <script>
    // Sticky header on scroll
    const header = document.querySelector('header');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    });

    // Mobile menu toggle
    const hamburger = document.querySelector('.hamburger');
    const navLinks = document.querySelector('.nav-links');
    
    if (hamburger) {
      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        navLinks.classList.toggle('active');
      });

      navLinks.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          hamburger.classList.remove('active');
          navLinks.classList.remove('active');
        });
      });
    }

    // Scroll reveal
    const observerOptions = {
      threshold: 0.12,
      rootMargin: '0px 0px -100px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('[data-scroll-reveal]').forEach(el => {
      observer.observe(el);
    });

    // Contact form
    const contactForm = document.getElementById('contactForm');
    if (contactForm) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(contactForm);
        const data = Object.fromEntries(formData);
        
        try {
          const response = await fetch('https://formsubmit.co/ajax/{{ site.email }}', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(data)
          });
          
          const messageEl = document.getElementById('formMessage');
          if (response.ok) {
            messageEl.textContent = 'Thank you! Your message has been sent.';
            messageEl.classList.remove('error');
            messageEl.classList.add('success');
            contactForm.reset();
          } else {
            messageEl.textContent = 'Something went wrong. Please try again.';
            messageEl.classList.remove('success');
            messageEl.classList.add('error');
          }
        } catch (error) {
          const messageEl = document.getElementById('formMessage');
          messageEl.textContent = 'Error sending message. Please try again.';
          messageEl.classList.remove('success');
          messageEl.classList.add('error');
        }
      });
    }
  </script>
</body>
</html>
